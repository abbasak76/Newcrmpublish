@@ -0,0 +1,19 @@
+import assert from 'node:assert/strict';
+import { validateCollectionTaskOutcome, COLLECTION_OUTCOME_OPTIONS } from '../src/lib/collectionTaskOutcome.ts';
+const task = { id: 't1', taskType: 'COLLECTION', source: 'GEO_ZONE', customerId: 'c1', accountId: 'c1' };
+const cleared = { id: 'p1', customerId: 'c1', accountId: 'c1', amount: 125000, status: 'CLEARED', method: 'TRANSFER', date: '2026-10-26' };
+const pending = { ...cleared, id: 'p2', status: 'PENDING' };
+const otherCustomer = { ...cleared, id: 'p3', customerId: 'c2', accountId: 'c2' };
+assert.equal(COLLECTION_OUTCOME_OPTIONS.length, 7, 'the outcome list is explicit and bounded');
+assert.equal(validateCollectionTaskOutcome(task, { outcome: 'PAYMENT_RECORDED', paymentId: 'p1' }, [cleared]).valid, true, 'a cleared payment for the same customer is accepted');
+assert.equal(validateCollectionTaskOutcome(task, { outcome: 'PAYMENT_RECORDED', paymentId: 'p1' }, [cleared]).collectedAmount, 125000, 'collected amount is derived from the payment record');
+assert.equal(validateCollectionTaskOutcome(task, { outcome: 'PAYMENT_RECORDED', paymentId: 'p2' }, [pending]).valid, false, 'pending payments cannot be reported as collected');
+assert.equal(validateCollectionTaskOutcome(task, { outcome: 'PAYMENT_RECORDED', paymentId: 'p3' }, [otherCustomer]).valid, false, 'a payment for another customer is rejected');
+assert.equal(validateCollectionTaskOutcome(task, { outcome: 'PAYMENT_RECORDED', paymentId: 'p4' }, []).valid, false, 'unknown payment IDs are rejected');
+assert.equal(validateCollectionTaskOutcome(task, { outcome: 'NO_PAYMENT' }).valid, false, 'failed outcomes require a reason');
+assert.equal(validateCollectionTaskOutcome(task, { outcome: 'NO_PAYMENT', failureReason: 'پرداخت انجام نشد' }).valid, true, 'failed outcomes accept a documented reason');
+assert.equal(validateCollectionTaskOutcome(task, { outcome: 'PROMISE_TO_PAY' }).valid, false, 'promise-to-pay requires a follow-up date');
+assert.equal(validateCollectionTaskOutcome(task, { outcome: 'PROMISE_TO_PAY', followUpDate: '2026-10-30' }).valid, true, 'promise-to-pay with follow-up date is accepted');
+assert.equal(validateCollectionTaskOutcome({ ...task, source: 'MANUAL' }, { outcome: 'VISIT_COMPLETED' }).valid, false, 'the flow cannot mutate unrelated tasks');
+assert.equal(validateCollectionTaskOutcome(task, { outcome: 'VISIT_COMPLETED', paymentId: 'p1' }, [cleared]).valid, false, 'payment cannot be attached to a non-payment outcome');
+console.log('PASS: 11 assertions (collection task outcome validation and payment-source integrity)');
