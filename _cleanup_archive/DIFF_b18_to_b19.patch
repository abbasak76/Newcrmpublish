+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+const root = path.resolve(new URL('..', import.meta.url).pathname);
+const workspace = fs.readFileSync(path.join(root, 'src/components/GeoIntelligenceWorkspace.tsx'), 'utf8');
+const app = fs.readFileSync(path.join(root, 'src/App.tsx'), 'utf8');
+const nav = fs.readFileSync(path.join(root, 'src/lib/navigation.ts'), 'utf8');
+const rbac = fs.readFileSync(path.join(root, 'src/lib/rbac.ts'), 'utf8');
+assert.ok(app.includes("path=\"/geo-intelligence\" element={guard('geo_intelligence'"), 'geo page is behind canonical workspace guard');
+assert.ok(nav.includes("id: 'geo_intelligence', path: '/geo-intelligence'"), 'geo page is reachable from main navigation');
+assert.ok(rbac.includes("case 'geo_intelligence': return this.hasPermission('geo.view')"), 'geo workspace has explicit RBAC gate');
+assert.ok(rbac.includes("geo:           { VIEW: ['geo.view'], CREATE: ['geo.manage'], EDIT: ['geo.manage'], ASSIGN: ['geo.manage']"), 'zone mutation actions have explicit geo.manage permission');
+assert.ok(workspace.includes("const canEdit = can('geo', 'EDIT')"), 'administrative workspace access alone does not bypass geo.manage for mutations');
+assert.ok(workspace.includes("rbac.canActOnRecord('accounts', 'VIEW'"), 'customer visibility reuses record scope rather than widening it');
+assert.ok(workspace.includes("isPointInsideZone(point, activeGeometry.geometry)"), 'zone customer matching uses polygon containment');
+assert.ok(workspace.includes('createZoneGeometryVersion'), 'geometry edits are versioned');
+assert.ok(workspace.includes('available: false') || workspace.includes('activeMetric.limitation'), 'unwired metrics explain why live heatmap is unavailable');
+assert.ok(workspace.includes('draft.zoneAssignments = draft.zoneAssignments.map'), 'assignment refresh preserves historical assignments by closing effective dates');
+assert.ok(workspace.includes('visibleCustomerIdSet.has(item.entityId)'), 'assignment counts are scoped to visible customers');
+assert.ok(workspace.includes("taskType: 'COLLECTION'"), 'zone operation creates a typed collection follow-up task');
+assert.ok(workspace.includes('processTaskCollaborationEvents(task, state, draft, true)'), 'task assignment uses the existing collaboration notification engine');
+assert.ok(workspace.includes("can('tasks', 'CREATE')"), 'collection task creation checks task-create permission');
+console.log('PASS: 14 assertions (geo workspace routing, RBAC, scope, geometry, versioning and honest metric availability)');
