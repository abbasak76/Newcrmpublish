+const component = fs.readFileSync('src/components/AtmosphereLayer.tsx','utf8');
+const css = fs.readFileSync('src/index.css','utf8');
+const version = fs.readFileSync('src/lib/version.ts','utf8');
+const pkg = JSON.parse(fs.readFileSync('package.json','utf8'));
+const metadata = JSON.parse(fs.readFileSync('metadata.json','utf8'));
+assert.match(component,/se-sky-moon/,'moon atmospheric layer exists');
+assert.match(component,/se-sky-cloud-1/,'cloud drift layers exist');
+assert.match(css,/@keyframes se-cloud-drift/,'slow cloud drift animation exists');
+assert.match(css,/prefers-reduced-motion:\s*reduce/,'system reduced-motion preference is respected');
+assert.match(css,/data-performance-mode="low"[\s\S]*?se-sky-clouds/,'low-performance mode reduces cloud layer');
+assert.match(css,/96s ease-in-out/,'cloud motion is slow and non-distracting');
+assert.equal(pkg.version,'0.12.3','package version synchronized');
+assert.match(version,/APP_VERSION = '0\.12\.3'/,'app version synchronized');
+assert.match(version,/r11-cp9-b27/,'app release label synchronized');
+assert.equal(metadata.version,'0.12.3','metadata version synchronized');
+assert.equal(metadata.release,'r11-cp9-b27','metadata release synchronized');
