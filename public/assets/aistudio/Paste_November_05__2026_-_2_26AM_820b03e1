    fields: [
      { id: 'accountId', name: 'accountId', label: 'حساب تجاری مربوطه', type: 'select', options: visibleAccounts.map(a => ({ value: a.id, label: a.name })), validation: { required: true }, colSpan: 2 } as any,
      ...OPPORTUNITY_FORM_SCHEMA.fields.map(f => (f.name === 'stage' ? { ...f, options: (f.options || []).filter(o => ['DISCOVERY', 'PROPOSAL', 'NEGOTIATION'].includes(String(o.value))) } : f)),
    ],
  }), [visibleAccounts]);

  const handleCreateOpportunity = (values: Record<string, any>) => {
    if (!can('opportunities', 'CREATE')) return denied('ثبت فرصت تجاری');
    if (!requireActiveUser(state, updateState, 'ثبت فرصت تجاری')) return;
    
    const accountId = String(values.accountId || '');
    if (!visibleAccounts.some(account => account.id === accountId)) return denied('انتخاب حساب خارج از محدوده مجاز');
    
    const creator = state.users.find(user => user.id === state.currentUserId);
    const newOpp: Opportunity = {
      id: generateId(),
      accountId,
      title: String(values.title).trim(),
      amount: Number(values.amount) || 0,
      stage: (values.stage || 'DISCOVERY') as OpportunityStage,
      expectedCloseDate: values.expectedCloseDate,
      ownerId: state.currentUserId!,
      branchId: creator?.branchId, territoryId: creator?.territoryId, teamId: creator?.teamId, tenantId: creator?.tenantId,
      createdAt: new Date().toISOString()
    };

    updateState(draft => {
      if (!draft.opportunities) draft.opportunities = [];
      draft.opportunities.unshift(newOpp);
      if (!draft.auditLogs) draft.auditLogs = [];
      draft.auditLogs.push({
        id: generateId(),
        action: 'OPPORTUNITY_CREATED',
        entityType: 'OPPORTUNITY',
        entityId: newOpp.id,
        details: `فرصت تجاری جدید "${newOpp.title}" با ارزش ${newOpp.amount.toLocaleString()} ریال ثبت شد`,
        actor: state.users.find(u => u.id === state.currentUserId)?.name || 'System',
        createdAt: new Date().toISOString()
      });
    });

    emitBusinessEvent('OPPORTUNITY_CREATED', 'OPPORTUNITY', newOpp.id, newOpp, state, updateState);
    setShowNewModal(false);
  };

  const handleUpdateStage = (oppId: ID, stage: OpportunityStage) => {
    if (!can('opportunities', 'EDIT')) return denied('تغییر مرحله فرصت');
    updateState(draft => {
      const opp = (draft.opportunities || []).find((o: any) => o.id === oppId);
      if (opp) opp.stage = stage;
    });
  };

  const activeFilters = [];
  if (activeStage !== 'ALL') {
    activeFilters.push({
      key: 'stage',
      label: `مرحله: ${stages.find(s => s.id === activeStage)?.label || activeStage}`,
      onRemove: () => setActiveStage('ALL')
    });
  }

  return (
    <div className="w-full space-y-4 px-2 py-2 sm:px-4 pb-32 font-sans" dir="rtl">
      
      <PageToolbar
        title="پایپ‌لاین فرصت‌های تجاری و مذاکرات"
        subtitle={`ارزش کل فیلتر جاری: ${formatCurrency(totalValue)} ریال`}
        search={oppQuery}
        onSearchChange={setOppQuery}
        searchPlaceholder="جستجوی عنوان فرصت یا نام مشتری..."
        resultCount={filtered.length}
        activeFilters={activeFilters}
        onClearAll={() => { setOppQuery(''); setActiveStage('ALL'); }}
        actions={
          <Button 
            variant="primary" 
            disabled={!can('opportunities', 'CREATE')} 
            title={can('opportunities', 'CREATE') ? undefined : 'مجوز ثبت فرصت را ندارید'} 
            onClick={() => setShowNewModal(true)} 
            icon={<Plus className="w-4 h-4" />}
          >
            فرصت جدید
          </Button>
        }
        filters={
          <div className="flex gap-2 overflow-x-auto no-scrollbar pb-1">
            {stages.map(s => (
              <button
                key={s.id}
                onClick={() => setActiveStage(s.id)}
                className={cn(
                  "px-4 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer whitespace-nowrap border",
                  activeStage === s.id 
                    ? "bg-primary text-white border-primary shadow-sm" 
                    : "bg-surface text-text-secondary border-border hover:bg-canvas"
                )}
              >
                {s.label}
              </button>
            ))}
          </div>
        }
      />

      <div className="space-y-4 pt-2">
        {filtered.length > 0 ? (
          filtered.map(opp => {
            const acc = visibleAccounts.find(a => a.id === opp.accountId);
            const stageDef = stages.find(s => s.id === opp.stage);
            
            // Map legacy colors to semantic tokens
            let badgeColor = 'bg-canvas text-text-secondary border-border';
            if (opp.stage === 'WON') badgeColor = 'bg-success-soft text-success border-success-border';
            else if (opp.stage === 'LOST') badgeColor = 'bg-danger-soft text-danger border-danger-border';
            else if (opp.stage === 'NEGOTIATION') badgeColor = 'bg-warning-soft text-warning border-warning-border';
            else if (opp.stage === 'PROPOSAL') badgeColor = 'bg-primary-soft text-primary border-primary/20';
            else if (opp.stage === 'DISCOVERY') badgeColor = 'bg-canvas text-text-main border-border';

            return (
              <Card key={opp.id} padding="lg" className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-5 hover:shadow-card transition-shadow bg-surface border-border">
                <div className="space-y-2.5">
                  <div className="flex items-center gap-3">
                    <div className="w-10 h-10 rounded-xl bg-primary-soft text-primary flex items-center justify-center shrink-0 border border-primary/20">
                      <TrendingUp size={18} />
                    </div>
                    <div>
                      <strong className="text-base font-bold text-text-main block">{opp.title}</strong>
                      <span className={cn("inline-block mt-1 px-2.5 py-0.5 text-[10px] font-bold rounded-lg border", badgeColor)}>
                        {stageDef?.label || opp.stage}
                      </span>
                    </div>
                  </div>
                  
                  <div className="flex flex-wrap items-center gap-4 text-xs text-text-secondary pt-1">
                    <button 
                      onClick={() => navigate(`/accounts/${opp.accountId}`)}
                      className="flex items-center gap-1.5 font-medium text-text-main hover:text-primary transition-colors cursor-pointer bg-canvas px-3 py-1.5 rounded-lg border border-border"
                    >
                      <Building2 size={14} className="text-text-secondary" /> {acc?.name || 'حساب نامشخص'}
                    </button>
                    {opp.expectedCloseDate && (
                      <span className="flex items-center gap-1.5 font-mono text-xs text-text-secondary bg-canvas px-3 py-1.5 rounded-lg border border-border">
                        <Calendar size={14} /> تاریخ هدف: {formatAppDate(opp.expectedCloseDate, state.settings?.locale)}
                      </span>
                    )}
                  </div>
                </div>

                <div className="flex flex-wrap items-center gap-4 self-end sm:self-center">
                  <div className="text-left bg-canvas p-3 rounded-xl border border-border min-w-[140px]">
                    <span className="text-[10px] font-bold text-text-secondary block mb-1">ارزش برآوردی معامله</span>
                    <strong className="text-base font-black font-mono text-primary tabular-nums block">{formatCurrency(opp.amount)} <span className="text-[10px] font-normal font-sans">ریال</span></strong>
                  </div>

                  <div className="flex gap-2">
                    {can('opportunities', 'EDIT') && opp.stage !== 'WON' && opp.stage !== 'LOST' && (
                      <>
                        <button 
                          onClick={() => handleUpdateStage(opp.id, 'WON')}
                          className="flex items-center gap-1.5 px-4 py-2.5 text-xs font-bold rounded-xl bg-success hover:bg-success/90 text-white transition-colors cursor-pointer shadow-sm active:scale-95"
                          title="ثبت به عنوان برنده (Won)"
                        >
                          <CheckCircle2 size={16} /> برنده
                        </button>
                        <button 
                          onClick={() => handleUpdateStage(opp.id, 'LOST')}
                          className="flex items-center gap-1.5 px-4 py-2.5 text-xs font-bold rounded-xl bg-canvas border border-border text-text-main hover:bg-danger-soft hover:text-danger hover:border-danger-border transition-colors cursor-pointer active:scale-95"
                          title="ثبت به عنوان از دست رفته (Lost)"
                        >
                          <XCircle size={16} /> باخت
                        </button>
                      </>
                    )}
                  </div>
                </div>
              </Card>
            );
          })
        ) : (
          <EmptyState 
            icon={<TrendingUp className="w-12 h-12 text-text-secondary opacity-50" />} 
            title="فرصتی یافت نشد" 
            description="فرصت تجاری جدید برای پیشبرد مذاکرات تعریف کنید." 
            actionLabel="ثبت فرصت جدید"
            onAction={() => setShowNewModal(true)}
          />
        )}
      </div>

      <Modal isOpen={showNewModal} onClose={() => setShowNewModal(false)} title="ثبت فرصت تجاری جدید">
        <DynamicFormRenderer
          schema={opportunitySchema}
          initialValues={{
            accountId: state.activeContextAccountId || state.accounts?.[0]?.id || '',
            stage: 'DISCOVERY',
            expectedCloseDate: new Date(Date.now() + 86400000 * 30).toISOString().split('T')[0]
          }}
          onSubmit={handleCreateOpportunity}
          onCancel={() => setShowNewModal(false)}
          submitLabel="ثبت فرصت"
        />
      </Modal>
    </div>
  );
}
