```tsx
import { getTenantName } from '../lib/orgPolicy';
import React, { useEffect, useMemo, useRef, useState } from 'react';
import { useLocation, useNavigate } from 'react-router-dom';
import {
  Search, Bell, Menu, X, Home, Users, CheckSquare, MessagesSquare, ChevronLeft,
  UserRound, Settings, Sparkles
} from 'lucide-react';
import { cn } from '../lib/utils';
import { AppState } from '../types';
import { Avatar } from './ui/Avatar';
import { NavigationDrawer } from './NavigationDrawer';
import { Sidebar } from './Sidebar';
import { AtmosphereLayer } from './AtmosphereLayer';
import { RBACService } from '../lib/rbac';
import { menuSections, filterSections } from '../lib/navigation';
import { haptics } from '../lib/haptics';
import { computeMissing, getOnboardingConfig } from '../lib/onboarding';
import { ThemeToggle } from './ThemeToggle';

interface LayoutProps {
  children: React.ReactNode;
  onOpenSearch?: () => void;
  unreadNotificationsCount?: number;
  onOpenNotifications?: () => void;
  state?: AppState;
  updateState?: (updater: (draft: AppState) => AppState | void) => void;
}

const NAV_ITEMS = [
  { id: 'home', path: '/', label: 'خانه', icon: Home },
  { id: 'accounts', path: '/accounts', label: 'مشتریان', icon: Users },
  { id: 'tasks', path: '/tasks', label: 'وظایف', icon: CheckSquare },
  { id: 'groups', path: '/groups', label: 'تعاملات', icon: MessagesSquare },
] as const;

export function Layout({ children, onOpenSearch, unreadNotificationsCount = 0, onOpenNotifications, state, updateState }: LayoutProps) {
  const location = useLocation();
  const navigate = useNavigate();

  const [navDrawerOpen, setNavDrawerOpen] = useState(false);
  const [avatarMenuOpen, setAvatarMenuOpen] = useState(false);
  const [isScrolled, setIsScrolled] = useState(false);

  const currentUser = state?.users?.find(u => u.id === state?.currentUserId);
  const currentRole = state?.roles?.find(r => r.id === currentUser?.roleId);
  const rbac = useMemo(() => (state ? new RBACService(state) : null), [state]);
  const canAccess = (tab: string) => (rbac ? rbac.canAccessWorkspace(tab as any) : true);
  const sections = useMemo(() => filterSections(menuSections, canAccess), [rbac]);
  const can = (perm: string) => (rbac ? rbac.hasPermission(perm as any) : true);

  const activeCustomer = state?.accounts?.find(a => a.id === state?.activeContextAccountId);
  const myTasks = (state?.tasks || []).filter((t: any) => t.assigneeType !== 'GROUP' && t.assigneeId === state?.currentUserId);
  const sidebarStats = state ? { openTasks: myTasks.filter((t: any) => t.status !== 'COMPLETED').length, doneTasks: myTasks.filter((t: any) => t.status === 'COMPLETED').length, overdue: myTasks.filter((t: any) => t.slaStatus === 'BREACHED' && t.status !== 'COMPLETED').length } : undefined;
  
  const ob = getOnboardingConfig(state as any); 
  const myFile: any = (state?.personnelFiles || []).find((f: any) => f.userId === state?.currentUserId);
  const fileMissing = state && ob.enabled && state.currentUserId && location.pathname !== '/personnel-file' && (!myFile || myFile.status !== 'APPROVED') ? computeMissing(myFile, ob).length : 0;
  
  const inChat = location.pathname.startsWith('/groups');
  const chatOpen = inChat && new URLSearchParams(location.search).get('c') !== null;
  const seg = location.pathname === '/' ? 'home' : location.pathname.split('/')[1];
  const activePageLabel = sections.flatMap(section => section.items).find(item => location.pathname === item.path || (item.path !== '/' && location.pathname.startsWith(item.path + '/')))?.label || (location.pathname === '/' ? 'داشبورد' : 'فضای کاری');

  // هندل کردن اسکرول برای تغییر شفافیت هدر
  useEffect(() => {
    const mainEl = document.getElementById('main-scroll-container');
    const handleScroll = () => setIsScrolled(mainEl ? mainEl.scrollTop > 20 : false);
    mainEl?.addEventListener('scroll', handleScroll);
    return () => mainEl?.removeEventListener('scroll', handleScroll);
  }, []);

  useEffect(() => { setAvatarMenuOpen(false); }, [location.pathname]);

  const goNav = (id: string, path: string) => {
    haptics.selection(); navigate(path);
  };

  // Swipe راست→چپ برای بازکردن چت
  const swipe = useRef<{ x: number; y: number; t: number } | null>(null);
  const blocked = (el: EventTarget | null) => !!(el as HTMLElement | null)?.closest?.('input,textarea,select,table,[contenteditable],[role="slider"]');
  const onPointerDown = (e: React.PointerEvent) => {
    if (seg !== 'home' || e.pointerType === 'mouse' || blocked(e.target)) { swipe.current = null; return; }
    const edge = 24; if (e.clientX < edge || e.clientX > window.innerWidth - edge) { swipe.current = null; return; }
    swipe.current = { x: e.clientX, y: e.clientY, t: Date.now() };
  };
  const onPointerUp = (e: React.PointerEvent) => {
    const s = swipe.current; swipe.current = null; if (!s) return;
    const dx = e.clientX - s.x, dy = e.clientY - s.y;
    if (dx < -80 && Math.abs(dy) < 40 && Date.now() - s.t < 600) { haptics.light(); navigate('/groups'); }
  };

  const topButtons = (
    <>
      <button onClick={onOpenSearch} aria-label="جستجو" className="se-interactive text-ink hover:text-primary transition-colors"><Search className="h-5 w-5" /></button>
      <button onClick={onOpenNotifications} aria-label="اعلان‌ها" className="relative se-interactive text-ink hover:text-primary transition-colors">
        <Bell className="h-5 w-5" />
        {unreadNotificationsCount > 0 && (
          <span className="absolute -end-1 -top-1 min-w-4 rounded-full bg-coral px-1 text-center text-[9px] font-bold leading-tight text-white ring-2 ring-white">{unreadNotificationsCount.toLocaleString('fa-IR')}</span>
        )}
      </button>
      <div className="relative">
        <button onClick={() => setAvatarMenuOpen(o => !o)} aria-label="منوی کاربر" className="se-interactive !p-0.5">
          <Avatar name={currentUser?.name || 'کاربر'} src={currentUser?.avatar} size="sm" />
        </button>
        {avatarMenuOpen && (
          <>
            <div className="fixed inset-0 z-40" onClick={() => setAvatarMenuOpen(false)} />
            <div role="menu" className="glass-strong absolute end-0 top-[calc(100%+12px)] z-50 w-56 overflow-hidden rounded-3xl p-2 shadow-modal">
              <div className="px-3 py-2"><div className="truncate text-xs font-bold text-ink">{currentUser?.name || 'کاربر سیستم'}</div><div className="truncate text-[11px] text-ink-soft">{currentRole?.name || ''}</div></div>
              <button role="menuitem" onClick={() => navigate('/profile')} className="flex w-full cursor-pointer items-center gap-2 rounded-2xl px-3 py-2.5 text-start text-xs font-bold text-ink hover:bg-primary/[.07]"><UserRound size={15} />پروفایل من</button>
              <div className="flex items-center justify-between px-3 py-2"><span className="text-xs font-bold text-ink">تم</span><ThemeToggle /></div>
              {canAccess('settings') && <button role="menuitem" onClick={() => navigate('/settings')} className="flex w-full cursor-pointer items-center gap-2 rounded-2xl px-3 py-2.5 text-start text-xs font-bold text-ink hover:bg-primary/[.07]"><Settings size={15} />تنظیمات</button>}
            </div>
          </>
        )}
      </div>
    </>
  );

  return (
    <div className="relative h-[100dvh] w-full overflow-hidden bg-transparent font-premium" dir="rtl">
      <a href="#main-content" className="sr-only focus:not-sr-only focus:fixed focus:start-3 focus:top-3 focus:z-[100] focus:rounded-full focus:bg-primary focus:px-4 focus:py-2 focus:text-xs focus:font-bold focus:text-white">پرش به محتوای اصلی</a>
      
      <AtmosphereLayer />
      
      {/* لایه اصلی برنامه */}
      <div className={cn('relative z-10 flex h-full w-full origin-left overflow-hidden transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]',
        navDrawerOpen ? 'pointer-events-none scale-[0.92] rounded-[2rem] opacity-70 shadow-2xl' : 'scale-100')}>

        <Sidebar sections={sections} user={currentUser} roleName={currentRole?.name} stats={sidebarStats} />

        <div className="relative flex min-w-0 flex-1 flex-col overflow-hidden">
          
          {/* هدر معلق سراسری - برای تمام صفحات */}
          <header className={cn("se-floating-header", isScrolled && "scrolled")}>
            <div className="flex items-center gap-3 min-w-0">
              <button onClick={() => setNavDrawerOpen(true)} aria-label="منوی اصلی" className="se-interactive text-ink lg:hidden"><Menu className="h-5 w-5" /></button>
              <div className="min-w-0">
                <h1 className="truncate text-[15px] font-extrabold tracking-tight text-ink flex items-center gap-1.5">
                  {seg === 'home' && <Sparkles size={16} className="text-gold" />}
                  {activePageLabel}
                </h1>
              </div>
            </div>
            <div className="flex items-center gap-4">{topButtons}</div>
          </header>

          {/* محتوای اصلی */}
          <main id="main-scroll-container" tabIndex={-1} className="w-full flex-1 overflow-y-auto outline-none" onPointerDown={onPointerDown} onPointerUp={onPointerUp} onPointerCancel={() => { swipe.current = null; }}>
            <div className={cn('mx-auto min-h-full w-full max-w-[1440px] pt-[calc(env(safe-area-inset-top,0px)+84px)]', inChat ? 'pb-0' : 'pb-[calc(env(safe-area-inset-bottom,0px)+100px)] lg:pb-24')}>
              {activeCustomer && seg === 'accounts' && (
                <div className="flex items-center gap-1.5 px-4 pb-2">
                  <ChevronLeft className="h-4 w-4 text-ink-soft" />
                  <span className="font-medium text-ink-soft text-xs">مشتری:</span>
                  <div className="glass flex items-center gap-1.5 rounded-full py-0.5 pe-1 ps-3">
                    <span className="max-w-[180px] truncate text-[11px] font-extrabold text-ink">{activeCustomer.name}</span>
                    <button aria-label="خروج از زمینه مشتری" onClick={() => updateState && updateState(d => { d.activeContextAccountId = null; d.activeContextCustomerId = null; })}
                      className="grid h-6 w-6 cursor-pointer place-items-center rounded-full text-ink-soft hover:bg-ink/10 hover:text-ink"><X className="h-3 w-3" /></button>
                  </div>
                </div>
