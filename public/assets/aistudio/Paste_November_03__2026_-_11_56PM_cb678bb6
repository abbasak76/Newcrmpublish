function spark(a,w=420,h=150){const mx=Math.max(...a)*1.1,x=i=>10+i*(w-20)/(a.length-1),y=v=>h-14-(v/mx)*(h-34);let d=`M${x(0)},${y(a[0])}`;a.forEach((v,i)=>{if(i){const cx=(x(i)+x(i-1))/2;d+=` C${cx},${y(a[i-1])} ${cx},${y(v)} ${x(i)},${y(v)}`}});const L=a.length-1;return`<svg viewBox="0 0 ${w} ${h}" style="width:100%;display:block"><defs><linearGradient id="ag" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2563EB" stop-opacity=".22"/><stop offset="1" stop-color="#2563EB" stop-opacity="0"/></linearGradient></defs><path d="${d} L${x(L)},${h} L${x(0)},${h}Z" fill="url(#ag)"/><path d="${d}" fill="none" stroke="#2563EB" stroke-width="2.4" stroke-linecap="round"/><circle cx="${x(L)}" cy="${y(a[L])}" r="5" fill="#fff" stroke="#2563EB" stroke-width="3"/></svg>`}
function home(){const D=DEMO,conic='conic-gradient('+(()=>{let c=0;return D.regions.map(r=>{const s=c;c+=r[1];return`${r[2]} ${s}% ${c}%`}).join(',')})()+')',dt=new Date().toLocaleDateString('fa-IR',{weekday:'long',day:'numeric',month:'long'}),
ch=(t,l,fn,b)=>`<div class="card lc"><div class="ch"><b>${t}</b><button onclick="${fn}">${l}</button></div>${b}</div>`;
return`<div class="dash"><div class="full"><div class="t-cap">سلام ${D.user.name} · ${dt}</div></div>
<div class="yar full"><div class="row" style="gap:10px"><span class="yb">یار</span><b class="yt">پیشنهاد هوشمند امروز</b></div><p>${D.ai.t}</p><div class="row" style="gap:12px"><button class="btn yr" onclick="toast()">مشاهده لیست</button><button class="btn sec" onclick="toast()">بعداً یادآوری کن</button></div></div>
${D.kpis.map(k=>`<div class="kp"><div class="kl">${k[0]}</div><div class="kv2">${k[1]}</div><div class="kd ${k[3]>0?'up':'dn'}">${ic(k[3]>0?'cup':'cdn')}${k[2]}</div></div>`).join('')}
<div class="s2">${ch('فعالیت‌های اخیر','مشاهده همه','toast()',D.acts.map(a=>`<div class="rw"><span class="at" style="--c:${a[1]}">${ic(a[0])}</span><div class="tx">${a[2]}<div class="t-cap">${a[3]}</div></div></div>`).join(''))}</div>
<div class="s2">${ch('وظایف امروز','همه وظایف',"go('task')",D.tasks.slice(0,3).map(t=>`<div class="rw" onclick="DEMO.tasks[${D.tasks.indexOf(t)}][4]^=1;draw()"><span class="ck ${t[4]?'d':''}">${t[4]?ic('check').replace('class="i"','class="i" style="width:14px;height:14px"'):''}</span><div class="tx"><div class="tt">${t[0]}</div><div class="row" style="gap:8px;margin-top:4px"><span class="tg2" style="--c:${t[3]}">${t[2]}</span><span class="t-cap">${t[5]}</span></div></div></div>`).join(''))}</div>
<div class="s2">${ch('فرصت‌های داغ','Pipeline','toast()',D.hot.map(o=>`<div class="rw"><div class="tx"><div class="tt" style="font-weight:600">${o[0]}</div><div class="t-cap">${o[1]}</div></div><div style="text-align:left;display:grid;gap:4px;justify-items:end"><b class="ov">${o[2]}</b><span class="stg">${o[3]}</span></div></div>`).join(''))}</div>
<div class="card s2"><div class="row sp"><b class="cti">روند فروش</b><span class="tg" style="--c:#2563EB">ماه</span></div>${spark(D.sales)}</div>
<div class="card s2"><b class="cti">توزیع مشتریان</b><div class="row" style="margin-top:12px;gap:20px"><div class="donut" style="background:${conic}"><span>${fa(1288)}</span></div><div class="grid" style="flex:1;gap:8px;font-size:11px">${D.regions.map(r=>`<div class="row sp"><span class="row" style="gap:8px"><i style="width:8px;height:8px;border-radius:50%;background:${r[2]}"></i>${r[0]}</span><b>${fa(r[1])}٪</b></div>`).join('')}</div></div></div>
<div class="card s2"><b class="cti">عملیات سریع</b><div class="qa" style="margin-top:12px">${[['ثبت مشتری','users','#16A34A'],['فرصت جدید','target','#2563EB'],['ثبت فاکتور','file','#D97706'],['وظیفه جدید','check','#DC2626']].map(q=>`<button style="--c:${q[2]}" onclick="toast()"><span class="ico">${ic(q[1])}</span>${q[0]}</button>`).join('')}</div></div></div>`}
function task(){const D=DEMO,T=D.tasks.filter(t=>(S.flt=='all'||(S.flt=='done'?t[4]:!t[4]))&&(t[0]+t[1]).includes(S.q)),st=[['مهلت گذشته',1,'alert','#DC2626'],['در آستانه تأخیر',5,'clock','#D97706'],['متوقف / نیازمند رفع مانع',0,'ban','#475569'],['بدون مهلت معتبر',0,'target','#2563EB']];
return`<div class="row sp" style="margin-bottom:16px"><div><div class="t-h2">مدیریت وظایف</div><div class="t-cap">پیگیری‌ها، ارجاعات و فایل‌های ضمیمه</div></div><button class="btn" onclick="toast()">${ic('plus')}وظیفه جدید</button></div>
<div class="dash" style="margin-bottom:16px">${st.map(s=>`<div class="card" style="--c:${s[3]}"><div class="row sp"><span class="ico">${ic(s[2])}</span><span class="t-cap" style="text-align:left">${s[0]}</span></div><div style="margin-top:12px;font-size:22px;line-height:1.2;font-weight:700;color:${s[3]}">${fa(s[1])}</div></div>`).join('')}</div>
<div class="chips" style="margin-bottom:12px">${[['all','همه وظایف'],['wait','در انتظار'],['done','تکمیل‌شده']].map(c=>`<button class="chip ${S.flt==c[0]?'on':''}" onclick="S.flt='${c[0]}';draw()">${c[1]}</button>`).join('')}</div>
<div class="sr" style="margin-bottom:12px">${ic('search')}<input class="in" id="q" placeholder="جستجو..." value="${S.q}" oninput="S.q=this.value;clearTimeout(window.qt);window.qt=setTimeout(()=>{draw();$('#q').focus();$('#q').setSelectionRange(99,99)},250)"></div>
<div class="card grid" style="gap:2px;padding:8px">${T.map(t=>`<div class="li ${t[4]?'done':''}" onclick="DEMO.tasks[${D.tasks.indexOf(t)}][4]^=1;draw()"><span class="ck ${t[4]?'d':''}">${t[4]?ic('check').replace('class="i"','class="i" style="width:14px;height:14px"'):''}</span><div style="flex:1"><div class="t" style="font-weight:500">${t[0]}</div><div class="t-cap">${t[1]}</div></div><span class="tg" style="--c:${t[3]}">${t[2]}</span></div>`).join('')||'<div class="t-cap" style="padding:24px;text-align:center">وظیفه‌ای پیدا نشد. فیلتر یا عبارت جستجو را تغییر دهید.</div>'}</div>`}
function cust(){const D=DEMO;if(S.cust!=null){const c=D.customers[S.cust],hc=c.hs>=70?'var(--success)':c.hs>=45?'var(--warning)':'var(--danger)',T=['خلاصه','Timeline','فرصت‌ها','وظایف','ارتباطات'];
const body=[`<div class="card"><div class="kv"><span>گروه</span><b>${c.lv}</b></div><div class="kv"><span>سطح اعتبار</span><b>${c.cr}</b></div><div class="kv"><span>میزان خرید سالانه</span><b>${c.bal}</b></div><div class="kv"><span>وضعیت</span><span class="tg" style="--c:#16A34A">${c.st}</span></div></div><div class="card" style="margin-top:12px"><b class="cti">فروش ماهانه</b><div class="bars" style="margin-top:12px">${D.months.map((m,i)=>`<i style="height:${m*10}%;animation-delay:${i*60}ms"></i>`).join('')}</div></div>`,
`<div class="card">${D.tl.map(g=>`<div class="t-cap" style="margin:8px 0">${g[0]}</div><div class="tl">${g[1].map(e=>`<div class="ev"><i>${ic(e[2]).replace('class="i"','class="i" style="width:15px;height:15px"')}</i><div><div style="font-weight:500">${e[0]}</div><div class="t-cap">${e[1]}</div></div></div>`).join('')}</div>`).join('')}</div>`,
`<div class="grid">${D.opps.map(o=>`<div class="card row sp"><div><b>${o[0]}</b><div class="t-cap">${o[1]}</div></div><span class="tg" style="--c:${o[3]}">${o[2]}</span></div>`).join('')}</div>`,
`<div class="card grid" style="gap:2px;padding:8px">${D.tasks.slice(0,3).map(t=>`<div class="li"><span class="ck"></span><div style="flex:1;font-weight:500">${t[0]}</div><span class="tg" style="--c:${t[3]}">${t[2]}</span></div>`).join('')}</div>`,
`<div class="card" style="text-align:center"><div class="t-cap" style="margin-bottom:12px">گفتگو با مشتری</div><button class="btn" onclick="go('chat');openChat(${S.cust})">${ic('chat')}باز کردن گفتگو</button></div>`][S.ct];
return`<div class="${innerWidth>=900?'twoc':''}" style="align-items:start"><div class="card" style="position:sticky;top:64px;z-index:5"><div class="row"><div class="pf av">${c.n[0]==='ش'?'ن':c.n[0]}</div><div style="flex:1"><div class="t-h4">${c.n}</div><span class="tg" style="--c:#2563EB">${c.s}</span></div><div style="width:92px"><div class="t-cap">Health ${fa(c.hs)}</div><div class="hs"><i style="width:${c.hs}%;background:${hc}"></i></div></div></div><div class="grid t-cap" style="gap:6px;margin-top:12px"><div class="row" style="gap:8px">${ic('phone')}${c.ph}</div><div class="row" style="gap:8px">${ic('mail')}${c.em}</div><div class="row" style="gap:8px">${ic('pin')}${c.ad}</div></div><div class="act">${[['تماس','phone'],['پیام','chat'],['موقعیت','pin'],['ویرایش','edit']].map(a=>`<button onclick="${a[1]=='chat'?`go('chat');openChat(${S.cust})`:'toast()'}"><span class="cb">${ic(a[1])}</span>${a[0]}</button>`).join('')}</div></div><div><div class="tabs">${T.map((t,i)=>`<button class="${i==S.ct?'on':''}" onclick="S.ct=${i};draw()">${t}</button>`).join('')}</div>${body}</div></div>`}
return`<div class="sr" style="margin-bottom:12px">${ic('search')}<input class="in" placeholder="جستجو در مشتریان..."></div><div class="grid" style="gap:12px">${D.customers.map((c,i)=>`<div class="li card" onclick="S.cust=${i};S.ct=0;draw();scrollTo(0,0)"><div class="cb av" style="width:44px;height:44px">${c.n[0]}</div><div style="flex:1"><div style="font-weight:600">${c.n}</div><div class="t-cap">${c.ad}</div></div><span class="tg" style="--c:#2563EB">${c.s}</span></div>`).join('')}</div>`}
function chat(){const un=DEMO.chats.reduce((a,c)=>a+c.u,0),L=DEMO.chats.filter(c=>S.cf=='all'||c.u).sort((a,b)=>b.pin-a.pin);
return`<div class="chatgrid"><div><div class="seg"><i style="transform:translateX(${S.cf=='all'?0:'-100%'})"></i><button onclick="S.cf='all';draw()">همه</button><button onclick="S.cf='unread';draw()">خوانده‌نشده ${fa(un)}</button></div><div class="sr" style="margin-bottom:8px">${ic('search')}<input class="in" placeholder="جستجو"></div><div>${L.map(c=>`<div class="tc" onclick="openChat(${DEMO.chats.indexOf(c)})"><div class="a av">${c.n[0]}</div><div class="bx"><div class="row sp"><b style="font-size:12px">${c.n}</b><span class="t-cap">${c.t}</span></div><div class="row sp" style="margin-top:2px"><span class="t-cap" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:70%">${c.m.at(-1)[1]}</span>${c.u?`<span class="ub">${fa(c.u)}</span>`:c.pin?`<span style="color:var(--text-tertiary)">${ic('pin')}</span>`:''}</div></div></div>`).join('')}</div></div><div class="xb" id="slot" style="display:block"></div></div>`}
function me(){return`<div class="card" style="text-align:center;padding:24px 16px"><div class="cb av" style="width:80px;height:80px;font-size:28px;margin:auto">ع</div><div class="t-h2" style="margin-top:12px">${DEMO.user.full}</div><div class="t-cap">${DEMO.user.role}</div></div><div class="card grid" style="gap:2px;margin-top:12px;padding:8px">${[['تم '+(S.dark?'روشن':'تیره'),S.dark?'sun':'moon','theme()'],['گزارش‌ها','chart','toast()'],['اعلان‌ها','bell','toast()'],['تنظیمات','cog','toast()']].map(r=>`<div class="li" onclick="${r[2]}"><span class="ico" style="--c:#2563EB">${ic(r[1])}</span><b style="font-weight:500">${r[0]}</b></div>`).join('')}</div>`}
function sales(){const D=DEMO,L=S.sf?D.neg:D.pre;
return`<div class="row sp" style="margin-bottom:16px"><div><div class="t-h2">فروش</div><div class="t-cap">پیش‌فاکتور و مذاکرات</div></div><button class="btn" onclick="toast()">${ic('plus')}پیش‌فاکتور جدید</button></div>
<div class="dash" style="margin-bottom:16px">${D.salesKpi.map(k=>`<div class="kp"><div class="kl">${k[0]}</div><div class="kv2">${k[1]}</div><div class="kd up">${ic('cup')}${k[2]}</div></div>`).join('')}</div>
<div class="seg"><i style="transform:translateX(${S.sf?'-100%':0})"></i><button onclick="S.sf=0;draw()">پیش‌فاکتورها</button><button onclick="S.sf=1;draw()">مذاکرات</button></div>
<div class="card lc">${L.map(o=>`<div class="rw"><div class="tx"><div class="tt" style="font-weight:600">${o[0]}</div><div class="t-cap">${o[1]}</div></div><div style="display:grid;gap:4px;justify-items:end"><b class="ov">${o[2]}</b><span class="stg">${o[3]}</span></div></div>`).join('')}</div>`}
function ops(){const D=DEMO,A=[['صدور درخواست سازمانی','req','#2563EB'],['ثبت جلسه','cal','#D97706'],['ثبت پیش‌فاکتور','file','#16A34A'],['ثبت تماس','phone','#2563EB'],['گزارش‌ها و شاخص‌ها','chart','#7C3AED'],['کاربران','users','#475569'],['گردش کار و تأییدها','flow','#D97706'],['وظیفه جدید','check','#DC2626']];
return`<div style="margin-bottom:16px"><div class="t-h2">عملیات</div><div class="t-cap">صف کارهای اجرایی و موارد نیازمند اقدام</div></div>
<div class="card lc" style="margin-bottom:16px"><div class="ch"><b>نیازمند اقدام</b><button onclick="toast()">همه</button></div>${D.queue.map(q=>`<div class="rw" onclick="toast()"><span class="at" style="--c:${q[3]}">${ic(q[4])}</span><div class="tx"><div class="tt">${q[0]}</div><div class="row" style="gap:8px"><span class="tg2" style="--c:${q[3]}">${q[2]}</span><span class="t-cap">${q[1]}</span></div></div></div>`).join('')}</div>
<div class="t-cap" style="margin:0 4px 8px;font-weight:600">اقدامات عملیاتی</div>
<div class="dash">${A.map(a=>`<button class="kp row" style="--c:${a[2]};text-align:right;gap:12px" onclick="toast()"><span class="at">${ic(a[1])}</span><span style="font-size:12px;font-weight:500">${a[0]}</span></button>`).join('')}</div>`}

const PG={home,cust,sales,task,ops,chat,me};
function header(){const sub=S.tab=='cust'&&S.cust!=null,d=innerWidth>=900;$('#hd').innerHTML=(d?`<button class="cb fl" onclick="document.body.classList.toggle('sbc')" aria-label="جمع کردن">${ic('panel')}</button>`:`<button class="cb fl" id="mb0" onclick="${sub?`S.cust=null;draw()`:'drawer(1)'}" aria-label="منو">${ic(sub?'back':'menu')}</button>`)+`<div id="ttl">${sub?'جزئیات مشتری':NAMES[S.tab]}</div>`+(d?`<div class="sr fl" style="width:300px;height:40px;border-radius:var(--radius-lg)">${ic('search')}<input class="in" placeholder="جستجوی سراسری..."></div><button class="btn ai" onclick="toast()">${ic('spark')}یار</button>`:`<button class="cb fl">${ic('search')}</button>`)+`<button class="cb fl">${ic('bell')}<em>۳</em></button>`}
function draw(){$('#v').innerHTML=PG[S.tab]();header();$('#fab').innerHTML=ic('plus');$('#fab').style.display=S.tab=='task'?'':'none';$('#sb').querySelectorAll('.it').forEach(b=>b.classList.toggle('on',b.dataset.k==S.tab));navLay();if(innerWidth>=900&&S.tab=='chat')openChat(S.chat??0)}
