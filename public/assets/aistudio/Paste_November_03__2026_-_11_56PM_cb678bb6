function theme(){S.dark=!S.dark;document.documentElement.dataset.t=S.dark?'dark':'';draw();buildDrawer()}
function toast(){const t=document.createElement('div');t.className='fl';t.style.cssText='position:fixed;z-index:99;top:76px;left:50%;transform:translateX(-50%);padding:10px 20px;border-radius:12px;font-size:11px;white-space:nowrap';t.textContent='این بخش در نسخه اجرایی به API متصل می‌شود.';document.body.append(t);setTimeout(()=>t.remove(),2200)}
function buildDrawer(){const it=[['داشبورد','home',"go('home')",S.tab=='home'],['مشتریان','users',"go('cust')",S.tab=='cust'],['فروش','target','toast()'],['گزارش‌ها','chart','toast()'],['وظایف','check',"go('task')",S.tab=='task'],['پیام‌ها','chat',"go('chat')",S.tab=='chat'],['تنظیمات','cog','toast()'],['تم '+(S.dark?'روشن':'تیره'),S.dark?'sun':'moon','theme()']];
$('#pn').innerHTML=`<div class="lg"><i>${ic('home')}</i>AKHAVAN CRM</div>`+it.map((i,n)=>`<button class="it ${i[3]?'on':''}" style="--n:${n}" onclick="${i[2]}"><span>${i[0]}</span>${ic(i[1])}</button>`).join('')+`<div class="us"><div class="cb av" style="width:36px;height:36px;font-size:12px;background:rgba(255,255,255,.2)">ع</div><div style="flex:1;min-width:0"><b>${DEMO.user.full}</b><small>${DEMO.user.role}</small></div>${ic('lback')}</div>`}
function togSec(b){b.classList.toggle('cl');b.nextElementSibling.hidden=!b.nextElementSibling.hidden}
function buildDrawer(){let n=0;const MENU=[['فروش و مشتریان',[['مشتریان','users','cust'],['بازرگانی فروش و پخش هوشمند','target','sales'],['فرصت‌های فروش','trend','sales'],['گفتگوها','chat','chat']]],['امور مالی و خزانه‌داری',[['دریافت و پرداخت','wallet'],['چک و تعهدات','card'],['گزارش‌های مالی','pie']]],['توزیع و عملیات',[['صف عملیات','grid','ops'],['توزیع و لجستیک','truck'],['بازگشت کالا','undo']]],['ابزارهای مدیریتی',[['پیگیری و تسک‌ها','check','task'],['گزارش‌ها و تحلیل‌ها','chart','ops'],['گردش کار و تأییدها','flow','ops']]]];
const it=(l,i,r,x)=>`<button class="it ${r&&r==S.tab&&!x?'on':''}" style="--n:${n++}" onclick="${r?`go('${r}')`:'toast()'}">${ic(i)}<span>${l}</span></button>`;
