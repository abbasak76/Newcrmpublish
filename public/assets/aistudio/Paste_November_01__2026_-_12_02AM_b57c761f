import React, { useState, useRef, useEffect } from 'react';
import { getJalaliDate, jalaliToGregorianISO, JALALI_MONTH_NAMES, getJalaliMonthDays, toPersianDigits } from '../../lib/jalali';
import { Calendar as CalendarIcon, ChevronDown, X } from 'lucide-react';
import { Modal } from './Modal';

export const CustomDatePicker = ({ value, onChange, placeholder = 'انتخاب تاریخ', className = '' }: any) => {
  const [isOpen, setIsOpen] = useState(false);
  const activeDate = value ? new Date(value) : new Date();
  const initial = getJalaliDate(activeDate);
  
  const [year, setYear] = useState(initial.jy);
  const [month, setMonth] = useState(initial.jm);
  const [day, setDay] = useState(initial.jd);

  const daysInMonth = getJalaliMonthDays(year, month);
  const years = Array.from({ length: 11 }, (_, i) => 1400 + i);

  const handleConfirm = () => {
    const safeDay = Math.min(day, daysInMonth);
    onChange(jalaliToGregorianISO(year, month, safeDay));
    setIsOpen(false);
  };

  const display = value ? `${toPersianDigits(day)} ${JALALI_MONTH_NAMES[month - 1]} ${toPersianDigits(year)}` : placeholder;

  return (
    <div className={className}>
      <button onClick={() => setIsOpen(true)} className="w-full bg-surface border border-border rounded-xl p-3 text-sm font-medium text-ink flex items-center justify-between shadow-sm hover:border-primary transition">
        <div className="flex items-center gap-2"><CalendarIcon size={18} className="text-primary" /><span>{display}</span></div>
        <ChevronDown size={16} className="text-ink-soft" />
      </button>

      <Modal isOpen={isOpen} onClose={() => setIsOpen(false)} title="انتخاب تاریخ" footer={<button onClick={handleConfirm} className="w-full py-3 bg-primary text-white rounded-xl font-bold">تایید تاریخ</button>}>
        <div className="flex justify-between gap-4 h-64 relative">
          {/* ستون روز */}
          <div className="flex-1 overflow-y-auto no-scrollbar snap-y snap-mandatory text-center" style={{ scrollSnapType: 'y mandatory' }}>
            {Array.from({ length: daysInMonth }, (_, i) => i + 1).map(d => (
              <div key={d} onClick={() => setDay(d)} className={`py-3 snap-center cursor-pointer text-lg transition-all ${day === d ? 'text-primary font-black scale-110' : 'text-ink-soft opacity-50'}`}>{toPersianDigits(d)}</div>
            ))}
          </div>
          {/* ستون ماه */}
          <div className="flex-1 overflow-y-auto no-scrollbar snap-y snap-mandatory text-center" style={{ scrollSnapType: 'y mandatory' }}>
            {JALALI_MONTH_NAMES.map((m, i) => (
              <div key={i} onClick={() => setMonth(i + 1)} className={`py-3 snap-center cursor-pointer text-lg transition-all ${month === i + 1 ? 'text-primary font-black scale-110' : 'text-ink-soft opacity-50'}`}>{m}</div>
            ))}
          </div>
          {/* ستون سال */}
          <div className="flex-1 overflow-y-auto no-scrollbar snap-y snap-mandatory text-center" style={{ scrollSnapType: 'y mandatory' }}>
            {years.map(y => (
              <div key={y} onClick={() => setYear(y)} className={`py-3 snap-center cursor-pointer text-lg transition-all font-mono ${year === y ? 'text-primary font-black scale-110' : 'text-ink-soft opacity-50'}`}>{toPersianDigits(y)}</div>
            ))}
          </div>
          
          {/* خط انتخاب‌گر وسط */}
          <div className="absolute top-1/2 inset-x-0 h-12 border-y-2 border-primary/20 bg-primary/5 pointer-events-none -translate-y-1/2 rounded-lg" />
        </div>
      </Modal>
    </div>
  );
};
