import React from 'react';
import { cn } from '../../lib/utils';

export const Button = ({ variant = 'primary', size = 'md', className, ...props }: any) => {
  const base = "inline-flex items-center justify-center gap-2 font-bold rounded-xl transition-all active:scale-95 disabled:opacity-50 disabled:pointer-events-none";
  const variants: any = {
    primary: "bg-primary text-white hover:bg-primary-hover shadow-sm",
    secondary: "bg-primary-50 text-primary hover:bg-primary-100",
    outline: "border border-border text-ink hover:bg-canvas",
    ghost: "text-ink hover:bg-black/5",
    danger: "bg-danger text-white hover:bg-red-700 shadow-sm"
  };
  const sizes: any = { sm: "h-9 px-4 text-xs", md: "h-11 px-6 text-sm", lg: "h-14 px-8 text-base", icon: "h-11 w-11 p-0" };
  return <button className={cn(base, variants[variant], sizes[size], className)} {...props} />;
};
