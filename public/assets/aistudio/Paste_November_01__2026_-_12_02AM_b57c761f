import React, { useEffect, useMemo, useRef, useState } from 'react';
import { useLocation, useNavigate } from 'react-router-dom';
import { Search, Bell, Menu, X, Home, Users, CheckSquare, MessagesSquare, UserRound, Plus, Settings } from 'lucide-react';
import { cn } from '../lib/utils';
import { AppState } from '../types';
import { Avatar } from './ui/Avatar';
import { NavigationDrawer } from './NavigationDrawer';
import { Sidebar } from './Sidebar';
import { AtmosphereLayer } from './AtmosphereLayer';
import { RBACService } from '../lib/rbac';
import { menuSections, filterSections } from '../lib/navigation';
import { ThemeToggle } from './ThemeToggle';

const NAV_ITEMS = [
  { id: 'home', path: '/', label: 'خانه', icon: Home },
  { id: 'accounts', path: '/accounts', label: 'مشتریان', icon: Users },
  { id: 'tasks', path: '/tasks', label: 'وظایف', icon: CheckSquare },
  { id: 'groups', path: '/groups', label: 'پیام‌ها', icon: MessagesSquare },
  { id: 'profile', path: '/profile', label: 'پروفایل', icon: UserRound },
] as const;

export function Layout({ children, onOpenSearch, unreadNotificationsCount = 0, onOpenNotifications, state, updateState }: any) {
  const location = useLocation();
  const navigate = useNavigate();
  const [navDrawerOpen, setNavDrawerOpen] = useState(false);
  const [avatarMenuOpen, setAvatarMenuOpen] = useState(false);
  const [isScrolled, setIsScrolled] = useState(false);

  const currentUser = state?.users?.find((u: any) => u.id === state?.currentUserId);
  const currentRole = state?.roles?.find((r: any) => r.id === currentUser?.roleId);
  const rbac = useMemo(() => (state ? new RBACService(state) : null), [state]);
  const canAccess = (tab: string) => (rbac ? rbac.canAccessWorkspace(tab as any) : true);

  const seg = location.pathname === '/' ? 'home' : location.pathname.split('/')[1];
  const activeTab = seg === 'accounts' ? 'accounts' : seg === 'groups' ? 'groups' : seg;
  const isDetailPage = /^\/(accounts|tasks|groups)\/.+/.test(location.pathname);
  
  const activePageLabel = NAV_ITEMS.find(i => i.id === activeTab)?.label || 'AKHAVAN CRM';

  useEffect(() => {
    const mainEl = document.getElementById('main-scroll-container');
    const handleScroll = () => setIsScrolled(mainEl ? mainEl.scrollTop > 20 : false);
    mainEl?.addEventListener('scroll', handleScroll);
    return () => mainEl?.removeEventListener('scroll', handleScroll);
  }, []);

  return (
    <div className="relative h-[100dvh] w-full overflow-hidden bg-canvas font-premium" dir="rtl">
      <AtmosphereLayer />
      
      <div className={cn('relative z-10 flex h-full w-full overflow-hidden', navDrawerOpen ? 'scale-[0.98] opacity-80' : 'scale-100 transition-all duration-300')}>
        <Sidebar sections={[]} user={currentUser} roleName={currentRole?.name} />
        
        <div className="relative flex min-w-0 flex-1 flex-col overflow-hidden">
          
          {/* هدر معلق سراسری */}
          <header className="fixed top-0 inset-x-0 z-40 px-4 pt-[calc(var(--safe-top)+12px)] pb-2 pointer-events-none">
            <div className={cn("mx-auto max-w-3xl flex items-center justify-between px-4 h-14 rounded-full transition-all duration-300 pointer-events-auto", isScrolled ? "glass shadow-floating" : "bg-transparent")}>
              
              <div className="flex items-center gap-3">
                {isDetailPage ? (
                  <button onClick={() => navigate(-1)} className="p-2 -mr-2 text-ink"><Menu size={20} className="rotate-180" /></button>
                ) : (
                  <button onClick={() => setNavDrawerOpen(true)} className="p-2 -mr-2 text-ink"><Menu size={20} /></button>
                )}
                <div className="flex items-center gap-2">
                   <Avatar name={currentUser?.name || 'کاربر'} size="sm" />
                   <span className="text-sm font-bold text-ink hidden sm:block">{activePageLabel}</span>
                </div>
              </div>

              <div className="flex items-center gap-2">
                <button onClick={onOpenSearch} className="p-2 text-ink hover:bg-black/5 rounded-full"><Search size={20} /></button>
                <button onClick={onOpenNotifications} className="p-2 text-ink hover:bg-black/5 rounded-full relative">
                  <Bell size={20} />
                  {unreadNotificationsCount > 0 && <span className="absolute top-1 right-1 w-2 h-2 bg-danger rounded-full ring-2 ring-white" />}
                </button>
              </div>
            </div>
          </header>

          {/* محتوای اصلی */}
          <main id="main-scroll-container" className="w-full flex-1 overflow-y-auto pb-[calc(var(--safe-bottom)+90px)]">
            <div className="mx-auto min-h-full w-full max-w-3xl pt-[calc(var(--safe-top)+72px)]">
              {children}
            </div>
          </main>
        </div>

        {/* دکمه عملیات سریع (مستقل در پایین چپ) */}
        <button 
          onClick={() => navigate('/tasks?new=1')} 
          className="fixed bottom-[calc(var(--safe-bottom)+80px)] left-6 z-40 grid h-14 w-14 place-items-center rounded-full bg-primary text-white shadow-floating hover:scale-105 transition-transform"
        >
          <Plus size={24} />
        </button>

        {/* ناوبری پایین (۵ گانه) */}
        <div className="fixed bottom-0 inset-x-0 z-40 px-4 pb-[calc(var(--safe-bottom)+12px)] pointer-events-none">
          <nav className="mx-auto max-w-md flex items-center justify-between bg-white/90 backdrop-blur-xl border border-white/50 shadow-floating rounded-full px-2 py-2 pointer-events-auto">
            {NAV_ITEMS.map(item => {
              const active = activeTab === item.id || (item.id === 'profile' && seg === 'profile');
              const Icon = item.icon;
              return (
                <button 
                  key={item.id} 
                  onClick={() => navigate(item.path)} 
                  className={cn("relative flex flex-col items-center justify-center w-14 h-12 rounded-full transition-all duration-300", active ? "text-primary" : "text-ink-soft hover:bg-black/5")}
                >
                  <Icon size={22} strokeWidth={active ? 2.5 : 1.8} className={active ? "animate-in zoom-in-50 duration-200" : ""} />
                  <span className="text-[10px] font-bold mt-1">{item.label}</span>
                  {active && <span className="absolute -bottom-1 w-1 h-1 bg-primary rounded-full" />}
                </button>
              )
            })}
          </nav>
        </div>

      </div>
      <NavigationDrawer isOpen={navDrawerOpen} onClose={() => setNavDrawerOpen(false)} state={state} />
    </div>
  );
}
