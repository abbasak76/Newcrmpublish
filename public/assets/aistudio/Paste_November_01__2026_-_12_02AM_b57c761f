import React, { useEffect } from 'react';
import { useNavigate, useLocation } from 'react-router-dom';
import { X, ChevronLeft, LogOut, Settings } from 'lucide-react';
import { Avatar } from './ui/Avatar';
import { menuSections, filterSections, isActivePath } from '../lib/navigation';
import { RBACService } from '../lib/rbac';
import { cn } from '../lib/utils';

export function NavigationDrawer({ isOpen, onClose, state }: any) {
  const navigate = useNavigate();
  const location = useLocation();
  const currentUser = state?.users?.find((u: any) => u.id === state?.currentUserId);
  const currentRole = state?.roles?.find((r: any) => r.id === currentUser?.roleId);

  useEffect(() => {
    if (isOpen) document.body.style.overflow = 'hidden';
    else document.body.style.overflow = '';
    return () => { document.body.style.overflow = ''; };
  }, [isOpen]);

  if (!isOpen) return null;

  const sections = filterSections(menuSections, id => (state ? new RBACService(state).canAccessWorkspace(id) : true));
  const go = (path: string) => { navigate(path); onClose(); };

  return (
    <div className="fixed inset-0 z-50 flex justify-end" dir="rtl">
      <div onClick={onClose} className="fixed inset-0 bg-black/40 backdrop-blur-sm transition-opacity" />
      
      {/* پنل منو با گرادیان زرشکی */}
      <div className="relative w-[85vw] max-w-[340px] h-full bg-gradient-to-b from-[#4B2031] via-[#71364B] to-[#2B1F24] shadow-2xl flex flex-col animate-in slide-in-from-right duration-300">
        
        <div className="absolute inset-0 bg-[url('/noise.png')] opacity-10 mix-blend-overlay pointer-events-none" />
        <div className="absolute top-0 right-0 w-64 h-64 bg-primary-500 rounded-full blur-[80px] opacity-30 pointer-events-none" />

        {/* هدر منو */}
        <div className="relative z-10 flex items-center justify-between p-6">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center text-white font-black text-xl border border-white/20">A</div>
            <div>
              <h2 className="text-white font-bold tracking-tight">AKHAVAN CRM</h2>
              <p className="text-white/60 text-[10px]">سیستم جامع مدیریت</p>
            </div>
          </div>
          <button onClick={onClose} className="p-2 bg-white/10 rounded-full text-white hover:bg-white/20 transition"><X size={18} /></button>
        </div>

        {/* لیست منوها */}
        <div className="relative z-10 flex-1 overflow-y-auto no-scrollbar px-4 py-2 space-y-6">
          {sections.map(section => (
            <div key={section.id}>
              <h3 className="text-white/50 text-[10px] font-bold uppercase tracking-wider mb-2 px-3">{section.title}</h3>
              <div className="space-y-1">
                {section.items.map(item => {
                  const active = isActivePath(location.pathname, item.path);
                  const Icon = item.icon;
                  return (
                    <button key={item.id} onClick={() => go(item.path)} 
                      className={cn("w-full flex items-center gap-3 px-4 py-3 rounded-2xl transition-all duration-300", active ? "bg-white/15 text-white shadow-sm border border-white/10" : "text-white/70 hover:bg-white/5 hover:text-white")}>
                      <Icon size={18} className={active ? "text-white" : "text-white/50"} />
                      <span className="text-sm font-medium">{item.label}</span>
                    </button>
                  )
                })}
              </div>
            </div>
          ))}
        </div>

        {/* کارت پروفایل پایین */}
        <div className="relative z-10 p-4 mt-auto">
          <div className="bg-white/10 backdrop-blur-md rounded-2xl p-3 border border-white/10 flex items-center justify-between cursor-pointer hover:bg-white/15 transition" onClick={() => go('/profile')}>
            <div className="flex items-center gap-3">
              <Avatar name={currentUser?.name || 'کاربر'} size="md" className="ring-2 ring-white/20" />
              <div>
                <div className="text-white text-xs font-bold">{currentUser?.name || 'کاربر سیستم'}</div>
                <div className="text-white/60 text-[10px] mt-0.5">{currentRole?.name || 'مدیر سیستم'}</div>
              </div>
            </div>
            <ChevronLeft size={16} className="text-white/50" />
          </div>
        </div>
      </div>
    </div>
  );
}
