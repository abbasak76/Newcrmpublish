              </button>
            </div>
          </header>

          <main
            id="main-scroll-container"
            data-chat={inChat ? 'true' : 'false'}
            className="w-full flex-1 overflow-y-auto main-content-scroll no-scrollbar"
          >
            <div className="mx-auto min-h-full w-full max-w-7xl pb-6">
              {children}
            </div>
          </main>
        </div>

        {!inChat && <BottomNav opsBadgeCount={opsBadgeCount} canAccess={canAccess} className="md:hidden" />}
      </div>

      <NavigationDrawer
        isOpen={navDrawerOpen}
        onClose={() => setNavDrawerOpen(false)}
        state={state}
        onLogout={onLogout}
      />
    </div>
  );
}
