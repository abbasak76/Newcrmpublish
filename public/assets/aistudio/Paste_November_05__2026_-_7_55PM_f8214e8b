  onLogout?: () => void;
  state?: AppState;
  updateState?: (updater: (draft: AppState) => AppState | void) => void;
}

export function Layout({
  children,
  onOpenSearch,
  unreadNotificationsCount = 0,
  onOpenNotifications,
  onLogout,
  state,
